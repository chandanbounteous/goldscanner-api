generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phone     BigInt   @unique

  @@map("users")
}

model Carigar {
  id           String        @id @default(uuid())
  codeName     String        @unique
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  goldArticles GoldArticle[]

  @@map("carigars")
}

model GoldArticle {
  id              String   @id @default(uuid())
  articleCode     String
  serialNumber    BigInt
  issueDate       DateTime
  issueDateNepali Json
  carigarId       String
  netWeight       Float
  grossWeight     Float
  stoneWeight     Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  karat           Int      @default(24)
  carigar         Carigar  @relation(fields: [carigarId], references: [id])
  basketArticles  CustomerBasketArticles[]

  @@map("gold_articles")
}

model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String?
  phone     BigInt?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  baskets   CustomerBasket[]

  @@map("customers")
}

model CustomerBasket {
  id                      String   @id @default(uuid())
  basketNumber            Int      @unique
  customerId              String
  isGoldRateFixed         Boolean  @default(false)
  fixedGoldRate24KPerTola Float?
  fixedGoldRateNepaliDate Json?
  oldGoldItemCost         Float    @default(0)
  extraDiscount           Float    @default(0)
  luxuryTax               Float    @default(0)
  finalCost               Float?
  isBilled                Boolean  @default(false)
  billingDate             DateTime?
  billingDateNepali       Json?
  isDiscarded             Boolean  @default(false)
  discardedDate           DateTime?
  discardedDateNepali     Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  customer                Customer @relation(fields: [customerId], references: [id])
  articles                CustomerBasketArticles[]

  @@map("customer_baskets")
}

model CustomerBasketArticles {
  id           String  @id @default(uuid())
  basketId     String
  articleId    String
  netWeight    Float
  grossWeight  Float
  addOnCost    Float   @default(0)
  wastage      Float   @default(0)
  makingCharge Float
  discount     Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  basket       CustomerBasket @relation(fields: [basketId], references: [id])
  article      GoldArticle    @relation(fields: [articleId], references: [id])

  @@map("customer_basket_articles")
}

enum UserRole {
  ADMIN
  USER
}
