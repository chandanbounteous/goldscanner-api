# Local Development Environment
NODE_ENV=development
PORT=3000

# Database (Docker containers)
DATABASE_URL=postgresql://goldscanner_user:goldscanner_password@localhost:5432/goldscanner_db
POSTGRES_DB=goldscanner_db
POSTGRES_USER=goldscanner_user
POSTGRES_PASSWORD=goldscanner_password

# Redis (Docker container)
REDIS_URL=redis://localhost:6379

# Application
JWT_SECRET=your_local_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# External APIs
GOLD_RATE_API_URL=https://fenegosida.org/