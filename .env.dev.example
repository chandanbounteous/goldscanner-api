# Development Testing Environment
NODE_ENV=development
PORT=3000

# Database (Docker containers)
DATABASE_URL=postgresql://goldscanner_user:goldscanner_password@postgres:5432/goldscanner_db_dev
POSTGRES_DB=goldscanner_db_dev
POSTGRES_USER=goldscanner_user
POSTGRES_PASSWORD=goldscanner_dev_password_change_this

# Redis (Docker container)
REDIS_URL=redis://redis:6379

# Application
JWT_SECRET=dev_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# External APIs
GOLD_RATE_API_URL=https://fenegosida.org/