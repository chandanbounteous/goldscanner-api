# Production Environment
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://goldscanner_user:goldscanner_password@postgres:5432/goldscanner_db
POSTGRES_DB=goldscanner_db
POSTGRES_USER=goldscanner_user
POSTGRES_PASSWORD=goldscanner_password

# Redis
REDIS_URL=redis://redis:6379

# Application
JWT_SECRET=PROD_JWT_SECRET
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info

# External APIs
GOLD_RATE_API_URL=https://fenegosida.org/

# Docker Configuration (for deployment)
DOCKER_USERNAME=bluekanishk
VERSION=latest

# Optional: Monitoring
ENABLE_METRICS=false
METRICS_PORT=9090